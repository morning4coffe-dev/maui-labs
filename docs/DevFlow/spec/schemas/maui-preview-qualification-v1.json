{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dotnet/maui-labs/main/docs/DevFlow/spec/schemas/maui-preview-qualification-v1.json",
  "title": "DevFlow preview qualification report v1",
  "type": "object",
  "required": [
    "schema",
    "kind",
    "contractVersion",
    "generatedAt",
    "status",
    "platform",
    "fingerprints",
    "profiles",
    "featureFlags",
    "review",
    "corpus",
    "metrics",
    "thresholds",
    "gates",
    "reasons",
    "artifactRefs",
    "exclusions"
  ],
  "properties": {
    "schema": { "const": 1 },
    "kind": { "const": "maui-preview-qualification" },
    "contractVersion": { "const": "preview-qualification-v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": [ "pass", "fail", "not-qualified" ] },
    "platform": { "type": "string", "minLength": 1 },
    "fingerprints": { "$ref": "#/$defs/fingerprints" },
    "profiles": { "type": "array", "items": { "$ref": "#/$defs/profile" } },
    "appleQa": { "$ref": "#/$defs/appleQa" },
    "featureFlags": { "$ref": "#/$defs/featureFlags" },
    "review": { "$ref": "#/$defs/review" },
    "corpus": { "$ref": "#/$defs/corpus" },
    "metrics": { "$ref": "#/$defs/metrics" },
    "thresholds": { "$ref": "#/$defs/thresholds" },
    "gates": { "type": "array", "items": { "$ref": "#/$defs/gate" } },
    "reasons": { "type": "array", "items": { "$ref": "#/$defs/reason" } },
    "artifactRefs": { "type": "array", "items": { "$ref": "#/$defs/artifactRef" } },
    "exclusions": { "type": "array", "items": { "$ref": "#/$defs/exclusion" } }
  },
  "$defs": {
    "fingerprints": {
      "type": "object",
      "required": [ "corpusVersion", "corpusFingerprint", "repositoryCommit", "testingPackageVersion", "packageId", "packageFingerprint", "toolVersion", "toolFingerprint", "policyVersion", "policyFingerprint" ],
      "additionalProperties": true
    },
    "profile": {
      "type": "object",
      "required": [ "platform", "deviceEvidenceKind", "realDevice", "deviceFingerprint", "runtimeFingerprint", "buildFingerprint", "packageFingerprint", "seedFingerprint", "backendStateFingerprint", "firstAttemptMode" ],
      "additionalProperties": true
    },
    "appleQa": {
      "type": "object",
      "required": [ "contractVersion", "platform", "experimental", "officialCoverage", "macCatalystEquivalent", "foregroundProof", "authenticatedTransport", "receipt", "cancellation", "parity", "appSourceDigest", "packageDigest", "flowDigests", "firstAttemptCount", "cleanAttemptCount", "artifactCount", "omissionCount", "xcodeVersion", "simulatorRuntime", "deviceIdFingerprint", "deviceProfile", "seedFingerprint" ],
      "additionalProperties": true
    },
    "featureFlags": {
      "type": "object",
      "required": [ "schema", "policyVersion", "workbenchEnabled", "agentAuthoringEnabled", "repairProposalsEnabled", "sourceProposalsEnabled", "traceImportExportEnabled", "autoApplyRepair", "autoApplySource", "modelProviderEnabled", "telemetryEgressEnabled", "requiredPullRequestGate", "killSwitches" ],
      "properties": {
        "schema": { "const": 1 },
        "autoApplyRepair": { "const": false },
        "autoApplySource": { "const": false },
        "modelProviderEnabled": { "const": false },
        "telemetryEgressEnabled": { "const": false },
        "requiredPullRequestGate": { "const": false }
      },
      "additionalProperties": true
    },
    "review": {
      "type": "object",
      "required": [ "planReviewStatus", "rubberDuckReviewStatus", "independentReviewStatus", "artifactRefs" ],
      "additionalProperties": true
    },
    "corpus": {
      "type": "object",
      "required": [ "staticOnly", "manifestValid", "caseSchemaValid", "curatedCases", "generatedCases", "deviceBackedCases", "mutationSeed", "generatorVersion", "errors" ],
      "properties": {
        "curatedRepairPositiveCases": {
          "type": "integer",
          "minimum": 0,
          "description": "Curated cases that model an eligible repair. Reported separately so a pooled denominator is never read as independent repair trials."
        },
        "curatedNoRepairCases": {
          "type": "integer",
          "minimum": 0,
          "description": "Hand-authored no-repair seeds. This is the curated share of the false-heal denominator."
        },
        "generatedNoRepairCases": {
          "type": "integer",
          "minimum": 0,
          "description": "Machine-generated no-repair mutants derived from the curated seeds. These are not independent trials."
        },
        "curatedClassificationLabeledCases": {
          "type": "integer",
          "minimum": 0,
          "description": "Curated cases carrying hand-assigned expectedFailureClass ground truth. Compare against curatedCases to see label coverage."
        },
        "provenanceComplete": {
          "type": [ "boolean", "null" ],
          "description": "True when every curated case records who labeled it, when, by what method, and from what source kind."
        },
        "provenanceSourceCounts": {
          "type": "array",
          "description": "Curated case counts grouped by provenance source kind. A corpus whose counts are entirely 'synthetic' has no observed-run evidence.",
          "items": {
            "type": "object",
            "required": [ "sourceKind", "count" ],
            "properties": {
              "sourceKind": { "enum": [ "synthetic", "observed-local-run", "observed-ci-run", "reported-issue", "unknown" ] },
              "count": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "metrics": {
      "type": "object",
      "required": [ "recordingValidity", "selectorStability", "repairPrecision", "repairRecall", "falseHeals", "abstention", "humanDecisionOutcomes", "calibration", "timeToDiagnosis", "traceReportSize", "runtimeOverhead", "flakeFirstAttemptStability", "privacySecurityEscapes" ],
      "properties": {
        "classificationAccuracy": {
          "$ref": "#/$defs/rateMetric",
          "description": "Share of labeled samples whose observed failure class matches the hand-assigned ground truth. Additive in v1; becomes required once every supported platform emits it."
        },
        "classificationMatrix": { "$ref": "#/$defs/classificationMatrix" }
      },
      "additionalProperties": true
    },
    "rateMetric": {
      "type": "object",
      "required": [ "state", "numerator", "denominator" ],
      "properties": {
        "state": { "type": "string" },
        "numerator": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 0 },
        "rate": { "type": [ "number", "null" ] },
        "independentEvaluations": {
          "type": "integer",
          "minimum": 0,
          "description": "Evaluations that are independent evidence, excluding cases derived from another case and machine-generated mutants. Count gates compare this, never the pooled denominator."
        },
        "independentDeviceRuns": { "type": [ "boolean", "null" ] },
        "sourceCounts": {
          "type": "array",
          "description": "Numerator and denominator split by sample source so a pooled rate can never be read as a single independent-trial count.",
          "items": {
            "type": "object",
            "required": [ "source", "numerator", "denominator" ],
            "properties": {
              "source": { "type": "string" },
              "numerator": { "type": "integer", "minimum": 0 },
              "denominator": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "classificationMatrix": {
      "type": "object",
      "required": [ "state" ],
      "properties": {
        "state": { "enum": [ "missing", "measured" ] },
        "method": { "type": "string" },
        "sampleCount": { "type": "integer", "minimum": 0 },
        "correct": { "type": "integer", "minimum": 0 },
        "labelCount": { "type": "integer", "minimum": 0 },
        "inferredSampleCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Cases where the classifier derived the class from replay facts rather than honouring a class the evidence already carried."
        },
        "inferredCorrect": { "type": "integer", "minimum": 0 },
        "stampHonouredSampleCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Cases whose evidence already named a known failure class, so the answer was copied rather than inferred."
        },
        "stampHonouredCorrect": { "type": "integer", "minimum": 0 },
        "missingReason": { "type": [ "string", "null" ] },
        "cells": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [ "expected", "observed", "count" ],
            "properties": {
              "expected": { "type": "string" },
              "observed": { "type": "string" },
              "count": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "perClass": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [ "failureClass", "support", "predicted", "correct" ],
            "properties": {
              "failureClass": { "type": "string" },
              "support": { "type": "integer", "minimum": 0 },
              "predicted": { "type": "integer", "minimum": 0 },
              "correct": { "type": "integer", "minimum": 0 },
              "precision": { "type": [ "number", "null" ] },
              "recall": { "type": [ "number", "null" ] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "thresholds": {
      "type": "object",
      "required": [ "confidenceLevel", "minimumRepairPrecision", "minimumNoRepairEvaluations", "maximumFalseHeals", "minimumSelectorStability", "maximumCalibrationEce", "minimumCleanFirstAttemptsPerTier1Flow" ],
      "properties": {
        "minimumClassificationAccuracy": { "type": "number", "minimum": 0, "maximum": 1 },
        "minimumClassificationEvaluations": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "gate": {
      "type": "object",
      "required": [ "gateId", "status", "message", "reasonCodes", "artifactRefs" ],
      "properties": {
        "status": { "enum": [ "pass", "fail", "not-qualified" ] }
      },
      "additionalProperties": true
    },
    "reason": {
      "type": "object",
      "required": [ "code", "severity", "message" ],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string" },
        "severity": { "enum": [ "warning", "error" ] },
        "message": { "type": "string" }
      }
    },
    "artifactRef": {
      "type": "object",
      "required": [ "kind", "digest", "reference", "redacted" ],
      "additionalProperties": false
    },
    "exclusion": {
      "type": "object",
      "required": [ "kind", "count", "reason" ],
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
